# 前端
frontend/node_modules/
frontend/dist/
frontend/.vite/

# 环境变量（含腾讯地图 Key 等敏感配置，仅保留 .env.example 模板）
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
